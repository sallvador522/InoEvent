# Server AI & Integrations
CONTEXT7_API_KEY=
GOOGLE_MAPS_PLATFORM_KEY=

# Pagamentos — segredo do webhook (fail-closed sem isto; gerar valor aleatório no deploy)
WEBHOOK_SECRET=

# Google Maps no navegador (convite + seletor de local). Chave pública restrita por referrer HTTP.
VITE_GOOGLE_MAPS_API_KEY=

# Meta Pixel (Facebook) — ID numérico do Events Manager
VITE_META_PIXEL_ID=
# Código de teste do Events Manager > Test Events (opcional, só dev)
VITE_META_PIXEL_TEST_CODE=

# Meta Conversions API (server-only — nunca expor no frontend)
META_CAPI_ACCESS_TOKEN=
META_PIXEL_ID=
META_CAPI_TEST_CODE=

# Firebase Admin Credentials (Serverless Backend)
# Option 1: Full JSON service account key stringified
FIREBASE_SERVICE_ACCOUNT_KEY=
# Option 2: Individual variables
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
