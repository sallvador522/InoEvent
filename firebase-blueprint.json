{
  "entities": {
    "User": {
      "title": "User",
      "description": "App user",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "plan": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Event": {
      "title": "Event",
      "description": "Event details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "iban": { "type": "string" },
        "accountName": { "type": "string" },
        "bankName": { "type": "string" },
        "contactPhone": { "type": "string" },
        "groomName": { "type": "string" },
        "brideName": { "type": "string" },
        "hosts": { "type": "string" },
        "locationName": { "type": "string" },
        "address": { "type": "string" },
        "mapLink": { "type": "string" },
        "receptionName": { "type": "string" },
        "receptionAddress": { "type": "string" },
        "musicTrack": { "type": "string" },
        "heroImage": { "type": "string" },
        "mapImage": { "type": "string" },
        "whiteLabelName": { "type": "string" },
        "whiteLabelLogo": { "type": "string" },
        "layoutMode": { "type": "string" },
        "isoDate": { "type": "string" },
        "plan": { "type": "string" },
        "gifts": {
          "type": "array",
          "items": { "type": "object" }
        },
        "dressCode": { "type": "object" },
        "timeline": {
          "type": "array",
          "items": { "type": "object" }
        },
        "gallery": {
          "type": "array",
          "items": {
            "type": ["string", "object"]
          }
        },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "ownerId", "title"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Credit transactions",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string" },
        "eventId": { "type": "string" }
      },
      "required": ["ownerId", "amount", "type", "description", "date"]
    },
    "Guest": {
      "title": "Guest",
      "description": "Guest RSVP",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" },
        "adults": { "type": "number" },
        "children": { "type": "number" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "phone", "status"]
    },
    "Visit": {
      "title": "Visit",
      "description": "Page view or visit log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" },
        "eventId": { "type": "string" },
        "referrer": { "type": "string" },
        "browser": { "type": "string" },
        "device": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["path", "timestamp"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "User" },
      "description": "User profiles"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "Transaction" },
      "description": "User transactions"
    },
    "/events/{eventId}": {
      "schema": { "$ref": "Event" },
      "description": "Events created by users"
    },
    "/events/{eventId}/guests/{guestId}": {
      "schema": { "$ref": "Guest" },
      "description": "Guests RSVP for an event"
    },
    "/visits/{visitId}": {
      "schema": { "$ref": "Visit" },
      "description": "Page visits analytics log"
    }
  }
}
