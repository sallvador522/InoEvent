rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Global Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Schema Validators ---
    function isValidUser(data) {
      return data.uid is string && data.email is string && data.email.matches('^[^@]+@[^@]+\\.[^@]+$') && (data.get('plan', null) is string || data.get('plan', null) == null);
    }

    function isValidEvent(data) {
      return data.title is string && data.title.size() <= 100 && 
             data.ownerId is string && 
             (data.get('date', null) is string || data.get('date', null) == null) &&
             (data.get('location', null) is string || data.get('location', null) == null) &&
             (data.get('locationName', null) is string || data.get('locationName', null) == null) &&
             (data.get('locationUrl', null) is string || data.get('locationUrl', null) == null);
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['ownerId', 'amount', 'type', 'description', 'date']) &&
             data.ownerId is string &&
             data.amount is number &&
             data.type in ['CREDIT', 'DEBIT'] &&
             data.description is string &&
             data.date is string &&
             (data.get('eventId', null) is string || data.get('eventId', null) == null);
    }

    // --- Rules ---
    match /{document=**} {
      allow read, write: if false; // Default deny
    }

    match /transactions/{transactionId} {
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(transactionId) && isValidTransaction(incoming()) && incoming().ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if true;
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().uid == request.auth.uid;
      allow update: if isOwner(userId) && 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan', 'whiteLabelName', 'whiteLabelLogo', 'updatedAt', 'credits']) &&
                       request.resource.data.uid == resource.data.uid &&
                       request.resource.data.email == resource.data.email;
    }

    match /events/{eventId} {
      // --- List ---
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      
      // --- Get ---
      allow get: if isValidId(eventId);
      
      // --- Create ---
      allow create: if isSignedIn() && isValidId(eventId) && isValidEvent(incoming()) && incoming().ownerId == request.auth.uid;
      
      // --- Update ---
      allow update: if isValidId(eventId) && resource != null && (
          (isSignedIn() && resource.data.ownerId == request.auth.uid && isValidEvent(incoming()) && incoming().ownerId == resource.data.ownerId) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['gallery'])) ||
          (isSignedIn() && resource.data.ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['clientToken']))
      );
      
      // --- Delete ---
      allow delete: if isSignedIn() && isValidId(eventId) && resource != null && resource.data.ownerId == request.auth.uid;
      
        // --- Guests Subcollection ---
      match /guests/{guestId} {
        allow read: if true; // Public read needed for ClientDashboard and capacity checks without Auth

        // Public can create guest
        allow create: if isValidId(guestId) && incoming().name is string;
        // Public can update if they provide the existing phone number
        allow update: if isValidId(guestId) && (
            (isSignedIn() && get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid) ||
            (existing().phone == incoming().phone)
        );
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid;
      }
    }
  }
}
