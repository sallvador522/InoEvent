rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Global Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.email == 'antoniosalvador522@gmail.com'; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    // Plano carimbado no evento vs plano da conta (ambos em minúsculas).
    // Tolera apelidos legados ('essencial', 'corporate', 'b2b', 'gratis'...):
    // a criação nunca deve falhar por capitalização/alias histórico.
    function planMatches(incomingPlan, storedPlan) {
      return incomingPlan == 'free' ||
        incomingPlan == storedPlan ||
        (incomingPlan == 'essential' && storedPlan == 'essencial') ||
        (incomingPlan == 'business' && (storedPlan == 'corporate' || storedPlan == 'b2b')) ||
        (incomingPlan == 'free' && (storedPlan == 'gratis' || storedPlan == 'grátis' || storedPlan == 'gratuito'));
    }
    function userPlanLower() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('plan', 'free').lower()
        : 'free';
    }

    // --- Schema Validators ---
    function isValidUser(data) {
      return data.uid is string && data.email is string && data.email.matches('^[^@]+@[^@]+\\.[^@]+$') && (data.get('plan', null) is string || data.get('plan', null) == null);
    }

    function isValidEvent(data) {
      return data.title is string && data.title.size() <= 100 && 
             data.ownerId is string && 
             (data.get('date', null) is string || data.get('date', null) == null) &&
             (data.get('location', null) is string || data.get('location', null) == null) &&
             (data.get('locationName', null) is string || data.get('locationName', null) == null) &&
             (data.get('locationUrl', null) is string || data.get('locationUrl', null) == null);
    }

    function isValidOrder(data) {
      return data.userId is string && data.eventId is string && data.plan is string && data.amount is number && data.billingStatus in ['pending','paid','failed','cancelled','refunded','expired'];
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['ownerId', 'amount', 'type', 'description', 'date']) &&
             data.ownerId is string &&
             data.amount is number &&
             data.type in ['CREDIT', 'DEBIT'] &&
             data.description is string &&
             data.date is string &&
             (data.get('eventId', null) is string || data.get('eventId', null) == null);
    }

    // --- Rules ---
    match /{document=**} {
      allow read, write: if false; // Default deny
    }

    match /transactions/{transactionId} {
      allow get: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow list: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && isValidId(transactionId) && isValidTransaction(incoming()) && incoming().ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)));
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().uid == request.auth.uid;
      allow update: if isAdmin() || (isOwner(userId) && 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['whiteLabelName', 'whiteLabelLogo', 'updatedAt']) &&
                       request.resource.data.uid == resource.data.uid &&
                       request.resource.data.email == resource.data.email);

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow write: if isAdmin() || isOwner(userId);
      }
    }

    match /events/{eventId} {
      // --- List ---
      allow list: if true;
      
      // --- Get ---
      allow get: if true;
      
      // --- Create ---
      // §7 limites são validados no backend (server/lib/entitlements), não só nas rules.
      // Ativação nasce sempre pendente — publicar/pagar é via servidor (confirmPayment).
      // Plano carimbado: só 'free' ou o plano da própria conta (planMatches tolera
      // apelidos legados) — trava plan:business arbitrário (que liberava
      // convidados ilimitados via leitura do servidor).
      allow create: if isSignedIn() && isValidId(eventId) && isValidEvent(incoming()) && incoming().ownerId == request.auth.uid &&
        incoming().get('billingStatus', 'pending') == 'pending' &&
        incoming().get('isPublished', false) == false &&
        incoming().get('isBlocked', false) == false &&
        planMatches(incoming().get('plan', 'free').lower(), userPlanLower()) &&
        planMatches(incoming().get('planId', 'free').lower(), userPlanLower());
      
      // --- Update ---
      // Campos de ativação (isPublished/billingStatus/isBlocked/account*) só via servidor.
      // expiresAt também SÓ via servidor (criação/ativação): o dono que estender a
      // validade paga sozinho tem o update negado. scheduledBlockDate continua
      // editável (controlo legítimo do organizador sobre o próprio bloqueio).
      allow update: if isValidId(eventId) && resource != null && (
          (
            isSignedIn() && 
            (resource.data.ownerId == request.auth.uid || exists(/databases/$(database)/documents/events/$(eventId)/team/$(request.auth.uid))) && 
            isValidEvent(incoming()) && 
            incoming().ownerId == resource.data.ownerId &&
            incoming().get('plan', 'essential').lower() == resource.data.get('plan', 'essential').lower() &&
            incoming().get('planId', resource.data.get('planId', 'free')).lower() == resource.data.get('planId', 'free').lower() &&
            incoming().get('isPublished', resource.data.get('isPublished', false)) == resource.data.get('isPublished', false) &&
            incoming().get('billingStatus', resource.data.get('billingStatus', 'pending')) == resource.data.get('billingStatus', 'pending') &&
            incoming().get('isBlocked', resource.data.get('isBlocked', false)) == resource.data.get('isBlocked', false) &&
            incoming().get('accountActive', resource.data.get('accountActive', false)) == resource.data.get('accountActive', false) &&
            incoming().get('accountExpiresAt', resource.data.get('accountExpiresAt', null)) == resource.data.get('accountExpiresAt', null) &&
            incoming().get('expiresAt', resource.data.get('expiresAt', null)) == resource.data.get('expiresAt', null)
          ) ||
          (
            isSignedIn() && 
            resource.data.ownerId == request.auth.uid && 
            incoming().diff(existing()).affectedKeys().hasOnly(['clientToken'])
          )
      );
      
      // --- Delete ---
      allow delete: if isSignedIn() && isValidId(eventId) && resource != null && resource.data.ownerId == request.auth.uid;
      
      // --- Contributions Subcollection ---
      match /contributions/{contributionId} {
        allow get: if true;
        allow list: if (isSignedIn() && (get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid || exists(/databases/$(database)/documents/events/$(eventId)/team/$(request.auth.uid)))) || isAdmin();
        allow create: if true; // Public can create a contribution
      }
      
      // --- Photos Subcollection ---
      match /photos/{photoId} {
        allow read: if true;
        allow create: if true;
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid;
      }

      // --- Team Subcollection ---
      match /team/{memberId} {
        allow read: if (isSignedIn() && (get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid || exists(/databases/$(database)/documents/events/$(eventId)/team/$(request.auth.uid)))) || isAdmin();
        allow create, update, delete: if isSignedIn() && get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid;
      }

      // --- Tables Subcollection ---
      match /tables/{tableId} {
        allow read: if (isSignedIn() && (get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid || exists(/databases/$(database)/documents/events/$(eventId)/team/$(request.auth.uid)))) || isAdmin();
        allow create, update, delete: if isSignedIn() && get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid;
      }

      // --- Messages Subcollection ---
      match /messages/{messageId} {
        allow read: if true;
        allow create: if true;
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid;
      }

      // --- Guests Subcollection ---
      // Leitura da LISTA (nomes + telefones): só dono/equipa/admin. Leitura de UM
      // convidado (pelo QR) continua pública — o convite não pede conta.
      // Receção e visão do cliente leem via API com o código do evento.
      match /guests/{guestId} {
        allow get: if true;
        allow list: if isSignedIn() && (
          get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid ||
          exists(/databases/$(database)/documents/events/$(eventId)/team/$(request.auth.uid)) ||
          isAdmin()
        );
        
        // Allow public to create guests (needed for direct RSVP from invitation), keeping list restricted to prevent data leak.
        // Validação de formato: nome obrigatório, status restrito e SEM campos de
        // privilégio (checkedIn, contas, ativação). Limite de quota e expiração são
        // impostos no servidor (POST /api/events/:id/rsvp) — caminho oficial.
        allow create: if true
          && incoming().get('name', '').size() > 0
          && incoming().get('status', 'CONFIRMED') in ['CONFIRMED', 'DECLINED', 'PENDING']
          && incoming().get('checkedIn', false) == false
          && !(incoming().keys().hasAny(['checkedInAt', 'accountActive', 'accountExpiresAt', 'isBlocked', 'isPublished', 'billingStatus', 'plan', 'planId', 'orderId']));
        
        allow update: if isValidId(guestId) && (
            (isSignedIn() && (get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid || exists(/databases/$(database)/documents/events/$(eventId)/team/$(request.auth.uid)))) ||
            isAdmin() ||
            (
                incoming().get('clientToken', 'invalid') == get(/databases/$(database)/documents/events/$(eventId)).data.clientToken &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkedIn', 'status', 'checkedInAt', 'clientToken', 'name']) &&
                incoming().get('name', '') == existing().get('name', '')
            )
        );
        allow delete: if (isSignedIn() && get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid) || isAdmin();
      }
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // Pedidos nascem pending via servidor; billingStatus só via admin (servidor bypassa rules).
      allow create: if isSignedIn() && isValidId(orderId) && incoming().userId == request.auth.uid && isValidOrder(incoming()) && incoming().billingStatus == 'pending';
      allow update: if isAdmin();
    }

    match /subscriptions/{subId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // Escrita SÓ via servidor (Admin SDK bypassa rules): antes o dono criava ou
      // editava a própria subscrição (status/validade) e forjava Business ativo.
      allow create, update, delete: if isAdmin();
    }

    match /visits/{visitId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }
  }
}
