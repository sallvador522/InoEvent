rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Global Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Schema Validators ---
    function isValidUser(data) {
      return data.uid is string && data.email is string && data.email.matches('^[^@]+@[^@]+\\.[^@]+$') && (data.plan is string || data.plan == null);
    }

    function isValidEvent(data) {
      return data.title is string && data.title.size() <= 100 && 
             data.ownerId is string && 
             (data.date is string || data.date == null) &&
             (data.location is string || data.location == null);
    }

    // --- Rules ---
    match /{document=**} {
      allow read, write: if false; // Default deny
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().uid == request.auth.uid;
      allow update: if isOwner(userId) && 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan']) &&
                       request.resource.data.uid == resource.data.uid &&
                       request.resource.data.email == resource.data.email &&
                       (request.resource.data.plan is string || request.resource.data.plan == null);
    }

    match /events/{eventId} {
      // --- Get ---
      allow get: if isSignedIn() && isValidId(eventId) && (resource == null || resource.data.ownerId == request.auth.uid);
      
      // --- Create ---
      allow create: if isSignedIn() && isValidId(eventId) && isValidEvent(incoming()) && incoming().ownerId == request.auth.uid;
      
      // --- Update ---
      allow update: if isSignedIn() && isValidId(eventId) && resource != null && resource.data.ownerId == request.auth.uid && isValidEvent(incoming()) && incoming().ownerId == resource.data.ownerId;
      
      // --- Delete ---
      allow delete: if isSignedIn() && isValidId(eventId) && resource != null && resource.data.ownerId == request.auth.uid;
    }
  }
}
