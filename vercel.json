{
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "{firebase-applet-config.json,dist/**,index.html}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/invite/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/plans",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
